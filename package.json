{
  "name": "lowpoly64-editor",
  "version": "0.8.0",
  "description": "Editor 3D low-poly estilo N64/PS1 para crear assets retro",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent:dev": "node ./scripts/run-agent-dev.mjs",
    "agent:companion": "node ./server/agent/companion.js",
    "agent:mcp": "node ./server/agent/mcp-stdio.js",
    "build": "vite build",
    "preview": "vite preview",
    "render": "node ./scripts/render-template.mjs",
    "audit:avatar-styles": "node ./scripts/avatar-style-audit.mjs",
    "audit:avatar-authoring": "node ./scripts/avatar-feature-authoring-audit.mjs",
    "audit:avatar-authoring:strict": "node ./scripts/avatar-feature-authoring-audit.mjs --strict",
    "audit:avatar-visual": "node ./scripts/avatar-visual-audit.mjs",
    "audit:avatar-hair": "node ./scripts/avatar-hair-helmet-audit.mjs",
    "audit:avatar-nose-ears": "node ./scripts/avatar-nose-ear-audit.mjs",
    "audit:code-size": "node ./scripts/code-size-audit.mjs",
    "clean:artifacts": "node ./scripts/clean-local-artifacts.mjs",
    "check": "npm run test:unit && node ./scripts/check-release-readiness.mjs && node ./scripts/check-character-mold-proportions.mjs && node ./scripts/check-ask-character-example.mjs && node ./scripts/check-standard-clips.mjs && node ./scripts/check-generated-heads.mjs && node ./scripts/check-avatar-sprites.mjs && node ./scripts/template-asset-audit.mjs && npm run audit:avatar-visual",
    "verify": "npm run check && vite build",
    "test:unit": "node --test tests/*.test.js",
    "test:agent": "node --test tests/agent-*.test.js",
    "test:agent:e2e": "node --test tests/integration/agent-browser-e2e.test.mjs",
    "test:mcp": "node --test tests/mcp-*.test.js",
    "test:e2e": "node ./scripts/run-playwright.mjs --project=smoke",
    "test:e2e:all": "node ./scripts/run-playwright.mjs",
    "capture:release": "node ./scripts/run-playwright.mjs --project=release-capture",
    "capture:release:headed": "node ./scripts/run-playwright.mjs --project=release-capture --headed"
  },
  "keywords": [
    "3d",
    "lowpoly",
    "n64",
    "threejs",
    "editor"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/opentype.js": "^1.3.9",
    "ajv": "^8.20.0",
    "jszip": "^3.10.1",
    "opentype.js": "^1.3.4",
    "three": "^0.183.2",
    "ws": "^8.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "vite": "^8.0.16"
  }
}
